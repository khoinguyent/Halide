# Database
DATABASE_URL=postgresql://user:password@localhost:5433/halide

# Firebase
FIREBASE_PROJECT_ID=your-project-id
# Path to service account JSON file, or leave empty if using default credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local dev only: set to true to skip Firebase token verification when no credentials (insecure; never in production)
# DEV_SKIP_FIREBASE_VERIFY=true

# Cloud Storage (R2/S3)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=halide-rolls
S3_REGION=auto
