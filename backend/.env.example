# Database
DATABASE_URL=postgresql://user:password@localhost:5433/halide

# Firebase
FIREBASE_PROJECT_ID=your-project-id
# Path to service account JSON file, or leave empty if using default credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local dev only: set to true to skip Firebase token verification when no credentials (insecure; never in production)
# DEV_SKIP_FIREBASE_VERIFY=true

# Cloud Storage (R2/S3)
# API endpoint = scheme + host only (no /bucket path; use S3_BUCKET_NAME below).
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=halide-rolls
S3_REGION=auto
# Optional: public (no-auth) R2 base for Plus/Pro roll images (path is /users/... after this base).
# If your CDN needs /{bucket}/users/..., set R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev/halide
# OR base=https://pub-xxx.r2.dev and R2_PUBLIC_APPEND_BUCKET_PATH=true (avoid both /halide in URL and the flag).
R2_PUBLIC_APPEND_BUCKET_PATH=false
R2_PUBLIC_BASE_URL=

# Encryption (Base64 32-byte string for Fernet)
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Gmail SMTP via 16-char App Password — https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=halide.app.notify@gmail.com
EMAIL_APP_PASSWORD=                 # 16 chars, no spaces
EMAIL_FROM_NAME=Halide
EMAIL_FROM_ADDRESS=hello@halide.io.vn

# Billing & RevenueCat
REVENUE_CAT_WEBHOOK_SECRET=
REVENUE_CAT_SECRET_KEY=
REVENUE_CAT_PROJECT_ID=
IS_REVENUE_CAT_SANDBOX=true
REVENUE_CAT_PRO_ENTITLEMENT_IDS=pro,plus,halide pro,halide_pro